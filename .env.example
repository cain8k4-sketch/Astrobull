# ── Supabase (creator sign-ups + leaderboard) ─────────────────────────────
# Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key

# ── Admin inbox ───────────────────────────────────────────────────────────
# Used on /admin — CHANGE THIS before public launch
VITE_ADMIN_PASSWORD=pick-a-strong-password

# ── Notifications on new signup ───────────────────────────────────────────
# Opens a mailto draft in the submitter's browser (simple)
VITE_OWNER_EMAIL=you@example.com

# Optional: Discord / Slack / Zapier / Make webhook (server-side style notify)
# Discord: Server → Integrations → Webhooks → Copy URL
# VITE_NOTIFY_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Optional Postgres (Better Auth / Neon) ────────────────────────────────
# DATABASE_URL=postgresql://...
