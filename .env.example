# Optional — live creator DB (Supabase REST)
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Optional — mailto alerts on new creator signups
# VITE_OWNER_EMAIL=you@example.com

# Optional — admin inbox password (default in code is astro-herd — change it)
# VITE_ADMIN_PASSWORD=change-me

# Production Postgres (Neon etc.) — set in Vercel, not in the browser
# DATABASE_URL=postgresql://...
