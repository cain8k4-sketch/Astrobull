# ── Supabase (creator sign-ups + leaderboard) ─────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key

# ── Admin LOGIN password (not an email) ───────────────────────────────────
# Used only on /admin to unlock the inbox
VITE_ADMIN_PASSWORD=pick-a-strong-password

# ── REAL email to your inbox when someone signs up (recommended) ──────────
# 1. Go to https://web3forms.com
# 2. Enter YOUR admin email → Create Access Key
# 3. Confirm the email they send you
# 4. Paste the access key here, then redeploy Vercel
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# ── Optional Discord / Zapier webhook ─────────────────────────────────────
# VITE_NOTIFY_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Optional mailto fallback only (opens visitor’s mail app — not automatic)
# VITE_OWNER_EMAIL=you@example.com

# DATABASE_URL=postgresql://...
